<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Redirecting...' }) %>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      background-color: var(--bg-dark);
    }
    .redirect-card {
      text-align: center;
      max-width: 400px;
      padding: 3rem 2rem;
    }
    .spinner {
      margin-bottom: 1.5rem;
      color: var(--primary-start);
    }
  </style>
</head>
<body>
  <div class="glass-card redirect-card">
    <i class="fa-solid fa-circle-notch fa-spin fa-3x spinner"></i>
    <h2 class="brand-accent" style="margin-bottom: 0.5rem;">Redirecting...</h2>
    <p style="color: var(--text-muted);">Taking you to your destination</p>
  </div>
  <script>
    setTimeout(function() {
      window.location.href = "<%= url.longUrl %>";
    }, 2000);
  </script>
</body>
</html>
