<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'URL Shortener Dashboard' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="main-wrapper">
    <div class="glass-card url-form-container">
      <div style="margin-bottom: 1.5rem;">
        <h2><i class="fa-solid fa-scissors" style="color: var(--primary-start);"></i> <span class="brand-accent">Shorten a New URL</span></h2>
        <p style="color: var(--text-muted);">Enter any link below to generate a short URL and instant QR code.</p>
      </div>

      <form id="shortenForm">
        <div class="url-input-grid">
          <div class="url-input-wrapper">
            <i class="fa-solid fa-link url-input-icon"></i>
            <input type="url" id="longUrlInput" class="form-control url-input" placeholder="Paste your destination URL (e.g. https://github.com/popular/repo)..." required>
          </div>
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-bolt" style="color: var(--primary-start);"></i> Shorten
          </button>
        </div>

        <div class="advanced-options-toggle" id="toggleAdvanced">
          <i class="fa-solid fa-chevron-down"></i> Custom Alias & Advanced Options
        </div>

        <div class="advanced-panel hidden" id="advancedPanel">
          <div class="form-group">
            <label class="form-label">Custom Alias (Optional)</label>
            <input type="text" id="customAliasInput" class="form-control" placeholder="e.g. my-cool-link">
          </div>
        </div>
      </form>

      <div id="shortenResult"></div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/app.js"></script>
</body>
</html>