<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Fast Modern URL Shortener & QR Code Generator' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="main-wrapper">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-badge">
        <i class="fa-solid fa-sparkles" style="color: var(--primary-start);"></i> <span class="brand-accent">Powered by Node.js & MongoDB</span>
      </div>
      <h1 class="hero-title"><span class="brand-accent">Shorten URLs.</span><br>Generate Instant QR Codes.</h1>
      <p class="hero-subtitle">Transform long, clunky URLs into short, trackable links and high-resolution QR codes in milliseconds.</p>
    </section>

    <!-- Quick URL Shortener Form (Guest Mode Enabled) -->
    <div class="glass-card url-form-container">
      <form id="shortenForm">
        <div class="url-input-grid">
          <div class="url-input-wrapper">
            <i class="fa-solid fa-link url-input-icon"></i>
            <input type="url" id="longUrlInput" class="form-control url-input" placeholder="Paste your long URL here (e.g. https://example.com/very-long-link)..." required>
          </div>
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-bolt" style="color: var(--primary-start);"></i> Shorten URL
          </button>
        </div>

        <div class="advanced-options-toggle" id="toggleAdvanced">
          <i class="fa-solid fa-chevron-down"></i> Custom Alias & Advanced Options
        </div>

        <div class="advanced-panel hidden" id="advancedPanel">
          <div class="form-group">
            <label class="form-label">Custom Alias (Optional)</label>
            <input type="text" id="customAliasInput" class="form-control" placeholder="e.g. my-custom-link">
            <small style="color: var(--text-dim); margin-top: 0.25rem; display: block;">Leave blank to auto-generate a unique short code.</small>
          </div>
        </div>
      </form>

      <!-- Shorten Result Display Area -->
      <div id="shortenResult"></div>
    </div>

    <!-- Feature Cards -->
    <section class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <i class="fa-solid fa-bolt-lightning"></i>
        </div>
        <h3 class="feature-title brand-accent">Instant Shortening</h3>
        <p class="feature-desc">Generate sleek short links in one click without any registration required.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <i class="fa-solid fa-qrcode"></i>
        </div>
        <h3 class="feature-title brand-accent">High-Res QR Codes</h3>
        <p class="feature-desc">Every shortened URL automatically generates a downloadable PNG QR code ready for print or digital sharing.</p>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <h3 class="feature-title brand-accent">Click Analytics</h3>
        <p class="feature-desc">Create a free account to track click counts, timestamps, and visitor analytics on all your short links.</p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/app.js"></script>
</body>
</html>
