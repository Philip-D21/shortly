<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Sign In' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="main-wrapper">
    <div class="auth-container">
      <div class="glass-card">
        <div class="auth-header">
          <h2 class="auth-title"><span class="brand-accent">Welcome Back</span></h2>
          <p class="auth-subtitle">Sign in to manage your shortened links and view analytics.</p>
        </div>

        <form id="loginForm">
          <div class="form-group">
            <label class="form-label" for="emailInput">Email Address</label>
            <input type="email" id="emailInput" class="form-control" placeholder="name@example.com" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="passwordInput">Password</label>
            <input type="password" id="passwordInput" class="form-control" placeholder="••••••••" required>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
            <i class="fa-solid fa-right-to-bracket" style="color: var(--primary-start);"></i> Sign In
          </button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
          Don't have an account yet? <a href="/api/auth/signup">Create an Account</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="/app.js"></script>
</body>
</html>
