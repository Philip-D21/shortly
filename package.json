{
  "name": "urlshortener",
  "version": "1.0.0",
  "description": "Modern URL Shortener and Instant QR Code Generator",
  "main": "build/app.js",
  "scripts": {
    "start": "node build/app.js",
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/app.ts",
    "seed:qa": "npm run build && node build/scripts/seed.js",
    "seed:qa:events": "npm run build && node build/scripts/seedEventsQA.js",
    "verify:qa:events": "npm run build && node build/scripts/verifyEventsQA.js",
    "test": "npm run build && node --test build/Test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.2.1",
    "morgan": "^1.10.0",
    "morgan-json": "^1.1.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.7",
    "shortid": "^2.2.16",
    "valid-url": "^1.0.9",
    "validator": "^13.9.0",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.19",
    "@types/qrcode": "^1.5.5",
    "@types/shortid": "^0.0.32",
    "@types/valid-url": "^1.0.4",
    "@types/validator": "^13.11.9",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
